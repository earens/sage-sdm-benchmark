# GBIF download credentials (required only for scripts/data_prep_scripts/gbif.py).
# Create an account at https://www.gbif.org/ and export these before running
# the GBIF download step:
#
#   export GBIF_USER=your_username
#   export GBIF_PWD=your_password
#   export GBIF_EMAIL=you@example.com
#
# Copy this file to `.env` (gitignored) or set the variables in your shell.

GBIF_USER=
GBIF_PWD=
GBIF_EMAIL=
